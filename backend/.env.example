# Database (local SQLite)
DATABASE_PATH=data/beepradar.db

# Registry (defaults to ../files/brain/sources_registry.json relative to backend/)
REGISTRY_PATH=

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Secrets for scheduler-triggered runs (optional; CLI ingest works without)
CRON_SECRET=
INGEST_SECRET=

# Source keys (sources without keys are skipped automatically)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
RAPIDAPI_KEY=
FANTASTIC_JOBS_API_KEY=
CLEANJOBDATA_API_KEY=
HIMALAYAS_API_KEY=
THEMUSE_API_KEY=
GITHUB_PAT=

# LLM tagging
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BATCH_SIZE=10

# Politeness
USER_AGENT=BeepRadarBot/1.0 (+https://localhost; contact: you@example.com)