# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the TRANSACTION pooler (port 6543) for Vercel serverless, e.g.
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Auth (login page): Project Settings -> API
# Enable Authentication -> Providers -> Email in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel (/admin): comma-separated emails allowed to manage sources,
# rate limits, ingestion runs and LLM tagging. Must match your Supabase login email.
ADMIN_EMAILS=

# Master key for the encrypted API-key vault (integration_secrets table).
# Generate yourself: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 hex chars (or 32-byte base64). Keep it secret; losing it means re-entering all keys.
SOURCE_KEYS_SECRET=

# Source keys (optional fallback — keys saved in the admin vault take precedence;
# sources without keys are skipped automatically)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
RAPIDAPI_KEY=
# Licensed job-data APIs (can also be saved in /admin -> API keys vault)
FANTASTIC_JOBS_API_KEY=         # Fantastic.jobs direct dashboard key (100 req / 500 jobs / 14-day trial)
SERPAPI_KEY=
JOBSPIPE_API_KEY=
CLEANJOBDATA_API_KEY=               # CleanJobData 14-day trial / 300 req/day
# Apify Actors: parsebird/naukri-jobs-scraper, crawloop/internshala-scraper, crawloop/foundit-jobs-scraper
APIFY_TOKEN=
HIMALAYAS_API_KEY=
THEMUSE_API_KEY=
GITHUB_PAT=

# LLM tagging
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BATCH_SIZE=10

# Politeness
USER_AGENT=BeepRadarBot/1.0 (+https://YOUR-DOMAIN; contact: YOUR-EMAIL)